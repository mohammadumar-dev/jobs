# Copy to jobs/.env (gitignored). Loaded by spring.config.import; real env vars win.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Origin the browser uses (the Next.js site).
APP_PUBLIC_ORIGIN=http://localhost:3000
# Same value as PROXY_SECRET in the web app. Generate with: openssl rand -hex 32
PROXY_SECRET=
# Google login: also start with SPRING_PROFILES_ACTIVE=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: migrate with an owner role, run with a restricted one (docs/db-roles.sql)
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=
