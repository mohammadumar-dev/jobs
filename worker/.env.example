# Copy to worker/.env (gitignored). Real environment variables win over this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# LLM tagging. Free tiers, tried in order; set any subset of these keys.
#   Gemini:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys   (free router: ~50 requests/day)
# If every provider fails or runs out of quota, a rule-based tagger fills in and the
# job is re-tagged by an LLM on a later run.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_CHAIN=gemini,groq,openrouter
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# LLM_MAX_JOBS=300          # LLM calls per run; the rest wait for the next run
#
# Paid alternative (Claude): set LLM_PROVIDER=anthropic and LLM_API_KEY.
# LLM_PROVIDER=chain        # chain | anthropic | none (rule-based only)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# LLM_BATCH=true            # Anthropic only: Message Batches API (50% cheaper) for 20+ jobs
# A URL where site owners can reach you; sent in the User-Agent of every request.
CONTACT_URL=
