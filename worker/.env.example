# Copy to worker/.env (gitignored). Real environment variables win over this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# LLM tagging. With no key the worker falls back to a rule-based tagger (dev only).
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# LLM_PROVIDER=anthropic   # or "none" to force the rule-based fallback
# LLM_BATCH=true           # use the Message Batches API (50% cheaper) for 20+ jobs
# A URL where site owners can reach you; sent in the User-Agent of every request.
CONTACT_URL=
